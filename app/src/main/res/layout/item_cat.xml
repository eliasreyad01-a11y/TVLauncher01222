<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_row"
    android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:minHeight="44dp"
    android:paddingStart="14dp" android:paddingEnd="14dp">
    <TextView android:id="@+id/tvName" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:ellipsize="end" android:maxLines="1" android:textColor="@color/white" android:textSize="16sp" />
    <TextView android:id="@+id/tvCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp"
        android:textColor="@color/dim" android:textSize="13sp" />
</LinearLayout>
